{
  // NShoptor AI vekili (ADR-004). Sırlar (AI_KEY, GOOGLE_SA_JSON) yalnız
  // `wrangler secret put` ile; bu dosyada ve repoda sır yok (C-041).
  "name": "nshoptor-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "5c5871cee9d16a81a908008f2a3de9af",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "head_sampling_rate": 0.1 },
    "traces": { "head_sampling_rate": 0.1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nshoptor",
      "database_id": "abf29641-7f69-4204-8e71-c7660195b635",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_URL": "https://evren-llmapi.ssyz.org.tr/v1",
    // Comma lists are fallback chains (ADR-008); vision models read photos.
    "AI_MODEL": "qwen3.8-flash-next,gemma-4-31b,deepseek-v4.1-flash",
    "AI_VISION_MODEL": "gemma-4-31b,qwen3-vl-30b,qwen3.8-flash-next",
    "AI_NOTHINK": "1",
    "AI_TIMEOUT_MS": "20000",
    "QUOTA_FREE": "10",
    // Remote 0002 migration verified 2026-10-26; retain table/counters on rollback.
    "TRIAL_ENABLED": "1",
    "QUOTA_PRO": "100",
    "QUOTA_MAX": "300",
    "GLOBAL_DAILY": "20000",
    "MAX_INPUT_CHARS": "6000",
    "PACKAGE_NAME": "com.crazypenguin.nshoptor"
  }
}
